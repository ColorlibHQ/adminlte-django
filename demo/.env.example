# Copy to `.env` for local development:  cp .env.example .env
#
# SECRET_KEY: the value below is the published development key. It is only
# accepted while DEBUG=True — with DEBUG=False the project refuses to start
# (ImproperlyConfigured) until you set a real one. Generate it with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Behind a reverse proxy, tell django-allauth where the client IP is, or sign-in
# answers 403 "Unable to determine client IP address". Use ONE of:
# ALLAUTH_TRUSTED_PROXY_COUNT=1                      # nginx appending X-Forwarded-For
# ALLAUTH_TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP  # behind Cloudflare

# Database — SQLite by default. For PostgreSQL (install psycopg[binary]):
# DATABASE_URL=postgres://user:password@localhost:5432/adminlte

# Email — console backend by default. For real SMTP delivery:
# EMAIL_URL=smtp://user:password@smtp.example.com:587
